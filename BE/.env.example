# ============================================================
# .env.example : ตัวอย่างตัวแปรสภาพแวดล้อมของ Backend
#
# วิธีใช้ : คัดลอกไฟล์นี้เป็น BE/.env แล้วแทนที่ค่าตัวอย่างด้วยค่าจริง
# ห้ามใส่ค่าจริงในไฟล์นี้ เพราะไฟล์นี้ขึ้น GitHub สาธารณะ
# ไฟล์ .env ตัวจริงถูก .gitignore กันไว้แล้ว จะไม่ขึ้น GitHub
# ============================================================

# ที่อยู่ฐานข้อมูล PostgreSQL (ได้จากปุ่ม Connect ใน Neon) ขึ้นต้นด้วย postgresql://
DATABASE_URL= your_postgresql_connection_string

# ชื่อโมเดล Gemini ที่ key นี้เรียกใช้ได้ (ชื่อเปลี่ยนบ่อย ถ้าเจอ error 404 ให้ดูรายการล่าสุดของ Google)
GEMINI_MODEL= gemini-3.5-flash-lite

# API key ของ Gemini (สร้างที่ aistudio.google.com)
GEMINI_API_KEY= your_gemini_api_key

# ที่อยู่เว็บ Frontend ใช้ตั้ง CORS ให้เรียก API ได้เฉพาะเว็บนี้ ไม่มี / ท้าย
# ตอนรันบนเครื่องใช้ http://localhost:5173
# บน Render ตั้งเป็น https://aie312-404-brain-not-found-fe.onrender.com
FRONTEND_URL= http://localhost:5173


# พอร์ตที่ BE ฟัง ถ้าไม่ตั้งใช้ 3000 (บน Render ไม่ต้องตั้ง Render กำหนดให้เอง)
PORT= 3000